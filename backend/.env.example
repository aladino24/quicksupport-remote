PORT=3000

# Optional relay server for video across restrictive NAT/mobile networks.
# Obtain these values from your TURN provider or a publicly reachable coturn server.
# ngrok http is for signaling and is NOT a TURN server.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# all: prefer direct connections, fall back to TURN.
# relay: force TURN to test the relay path (requires TURN settings above).
ICE_TRANSPORT_POLICY=all
